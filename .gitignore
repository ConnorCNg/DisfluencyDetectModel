# SEP-28k audio (large); keep directory placeholders
data/sep28k/wavs/*
!data/sep28k/wavs/.gitkeep
data/sep28k/clips/*
!data/sep28k/clips/.gitkeep

# Training checkpoints (large)
checkpoints/
checkpoints_test/
checkpoints_*/

# Reference PDFs / literature (local copies)
studies/

# Local / tooling
__pycache__/
*.pyc
.DS_Store
*.log

# Heavy derived caches (regenerate: see artifacts/REGENERATE_CACHES.txt)
.cache/

# Optional local run outputs (not used in README commands)
artifacts/smoke/

# Optional local verify bundle (bash scripts/run_readme_verify_suite.sh)
artifacts/verify_run/

# 3 s clip tree (large); same pattern as sep28k/clips
data/SEP-28k_CLIP/

# Ad-hoc PID files from background runs
*.pid

# Optional local copy of HF hub snapshot (not tracked; use default HF cache instead)
artifacts/huggingface_hub/
